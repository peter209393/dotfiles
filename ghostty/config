# Ghostty config — macOS / Linux 通用
# 文档: https://ghostty.org/docs/config
# 校验: ghostty +validate-config

# --- 字体(机器上安装的是 FiraCode Nerd Font,名字必须完全一致否则会回退默认字体) ---
font-family = FiraCode Nerd Font
font-family = PingFang SC   # 中文统一走苹方，避免 CoreText 随机兜底导致大小不一
font-size = 16
font-feature = ss01   # 直杠 % -> 打叉
font-feature = ss02   # 直杠 * -> 打叉
font-feature = cv30   # 更直的小写 f / 4

# --- 主题与外观 ---
# 换主题:ghostty +list-themes 里挑(463 个内置主题,方向键实时预览)
# alacritty 那边的 themes/ 目录就是从这些主题生成的,两边保持同名即可一致
theme = Carbonfox
background-opacity = 1
cursor-style = bar
cursor-style-blink = false

# --- 窗口 ---
window-padding-x = 8
window-padding-y = 8
window-padding-balance = true
window-theme = ghostty
macos-titlebar-style = tabs

# --- 按键 / 剪贴板 ---
macos-option-as-alt = true
copy-on-select = clipboard
clipboard-paste-protection = false
confirm-close-surface = false

# --- Shell / 行为 ---
shell-integration = fish
shell-integration-features = cursor,sudo,title
mouse-scroll-multiplier = 2
quit-after-last-window-closed = true
