{
  // 扁平贴边细条:整条深色实心,无圆角无留白,模块只出图标不出数字
  "layer": "top",
  "position": "top",
  "height": 26,
  "spacing": 0,

  "modules-left": ["sway/mode", "sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["battery", "pulseaudio", "network", "tray"],

  // 焦点工作区显示实心圆点,其余显示编号
  "sway/workspaces": {
    "format": "{icon}",
    "format-icons": {
      "focused": "\u25cf",
      "urgent": "\u25cf"
    },
    "disable-scroll": false
  },

  // resize / gaps 模式激活时才显示
  "sway/mode": {
    "format": "{}"
  },

  "clock": {
    "format": "{:%A %H:%M}",
    "format-alt": "{:%Y-%m-%d %A}",
    "tooltip-format": "<tt><small>{calendar}</small></tt>",
    "calendar": {
      "mode": "month",
      "format": {
        "today": "<span color='#f38ba8'><b>{}</b></span>"
      }
    }
  },

  // 图标全部写成 \u 转义:U+F2xx 是 Font Awesome 段,U+F0xxx 是 Material 段(需代理对)
  "battery": {
    "states": { "warning": 30, "critical": 15 },
    "format": "{icon}",
    "format-charging": "\uf0e7",
    "format-plugged": "\uf0e7",
    "format-icons": ["\uf244", "\uf243", "\uf242", "\uf241", "\uf240"],
    "tooltip-format": "{capacity}%  {timeTo}",
    "interval": 30
  },

  "pulseaudio": {
    "format": "{icon}",
    "format-muted": "\uf026",
    "format-icons": { "default": ["\uf026", "\uf027", "\uf028"] },
    "tooltip-format": "{desc}  {volume}%",
    "on-click": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +5%",
    "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -5%"
  },

  "network": {
    "format-wifi": "\uf1eb",
    "format-ethernet": "\udb80\ude00",
    "format-disconnected": "NO\uf1eb",
    "tooltip-format-wifi": "{essid}  {signalStrength}%  {ipaddr}",
    "tooltip-format-ethernet": "{ifname}  {ipaddr}",
    "on-click": "nm-connection-editor"
  },

  "tray": {
    "icon-size": 15,
    "spacing": 10
  }
}
