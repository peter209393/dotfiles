# Template for machine-local secrets. Copy to local.fish and fill in real values.
# local.fish is gitignored and never committed.
#
# set -x PRIVATE_KEY 0x...
# set -x BSC_DEPLOY_SECRET_KEY 0x...
# set -x ZAI_API_TOKEN ...          # voice-type (sway) reads this from the environment
# set -x VT_ARK_API_KEY ark-...
# set -x VT_ARK_PLAN_API_KEY ark-...
